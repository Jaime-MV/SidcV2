generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------------------
// MÓDULO: INVENTARIO Y PRODUCTOS
// -------------------------------------------------------------

model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique
  descripcion String?
  productos   Producto[]
}

model Producto {
  id           Int     @id @default(autoincrement())
  nombre       String
  descripcion  String?
  codigoBarras String? @unique
  precioBase   Decimal @db.Decimal(10, 2)

  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  lotes         Lote[]
  detallesVenta DetalleVenta[]
  promociones   PromocionProducto[]
}

model Lote {
  id                 Int      @id @default(autoincrement())
  numeroLote         String   @unique
  fechaFabricacion   DateTime
  fechaVencimiento   DateTime
  cantidadInicial    Int
  cantidadDisponible Int

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  movimientos MovimientoInventario[]
}

model MovimientoInventario {
  id              Int            @id @default(autoincrement())
  tipoMovimiento  TipoMovimiento
  cantidad        Int
  fechaMovimiento DateTime       @default(now())
  referencia      String? // Ej. "Venta V-001", "Devolución D-001"

  loteId Int
  lote   Lote @relation(fields: [loteId], references: [id])
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
}

// -------------------------------------------------------------
// MÓDULO: RUTAS Y VENDEDORES
// -------------------------------------------------------------

model Vendedor {
  id       Int     @id @default(autoincrement())
  nombre   String
  telefono String?
  activo   Boolean @default(true)

  rutas  Ruta[]
  ventas Venta[]
}

model Ruta {
  id          Int     @id @default(autoincrement())
  nombre      String
  descripcion String?

  vendedorId Int
  vendedor   Vendedor @relation(fields: [vendedorId], references: [id])

  clientes Cliente[]
}

// -------------------------------------------------------------
// MÓDULO: CLIENTES Y CRÉDITO
// -------------------------------------------------------------

model Cliente {
  id             Int     @id @default(autoincrement())
  nombre         String
  identificacion String  @unique // NIT o Documento Similar
  direccion      String
  telefono       String?
  email          String?

  // Condición de pago/Crédito
  limiteCredito Decimal @default(0) @db.Decimal(12, 2)
  saldoActual   Decimal @default(0) @db.Decimal(12, 2)
  diasCredito   Int     @default(0) // 0 denota Contado

  rutaId Int?
  ruta   Ruta? @relation(fields: [rutaId], references: [id])

  ventas Venta[]
  cobros Cobro[]
}

// -------------------------------------------------------------
// MÓDULO: VENTAS Y FACTURACIÓN
// -------------------------------------------------------------

model Venta {
  id             Int         @id @default(autoincrement())
  fecha          DateTime    @default(now())
  subtotal       Decimal     @db.Decimal(12, 2)
  descuentoTotal Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  estado         EstadoVenta @default(COMPLETADA)

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  vendedorId Int
  vendedor   Vendedor @relation(fields: [vendedorId], references: [id])

  detalles     DetalleVenta[]
  factura      Factura? // Relación 1 a 1
  devoluciones Devolucion[]
}

enum EstadoVenta {
  PENDIENTE
  COMPLETADA
  ANULADA
}

model DetalleVenta {
  id             Int     @id @default(autoincrement())
  cantidad       Int
  precioUnitario Decimal @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  ventaId Int
  venta   Venta @relation(fields: [ventaId], references: [id])

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])
}

model Factura {
  id            Int           @id @default(autoincrement())
  numeroFactura String        @unique
  fechaEmision  DateTime      @default(now())
  total         Decimal       @db.Decimal(12, 2)
  estado        EstadoFactura @default(CREADA)

  ventaId Int   @unique
  venta   Venta @relation(fields: [ventaId], references: [id])

  cobros Cobro[]
}

enum EstadoFactura {
  CREADA
  PAGADA
  PAGADA_PARCIALMENTE
  ANULADA
}

// -------------------------------------------------------------
// MÓDULO: COBROS (PAGOS)
// -------------------------------------------------------------

model Cobro {
  id             Int        @id @default(autoincrement())
  fecha          DateTime   @default(now())
  monto          Decimal    @db.Decimal(12, 2)
  metodoPago     MetodoPago
  referenciaPago String?

  facturaId Int
  factura   Factura @relation(fields: [facturaId], references: [id])

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id])
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  CHEQUE
}

// -------------------------------------------------------------
// MÓDULO: DEVOLUCIONES
// -------------------------------------------------------------

model Devolucion {
  id     Int              @id @default(autoincrement())
  fecha  DateTime         @default(now())
  motivo String
  estado EstadoDevolucion @default(PROCESADA)

  ventaId Int
  venta   Venta @relation(fields: [ventaId], references: [id])
}

enum EstadoDevolucion {
  PENDIENTE
  PROCESADA
  RECHAZADA
}

// -------------------------------------------------------------
// MÓDULO: PROMOCIONES
// -------------------------------------------------------------

model Promocion {
  id             Int      @id @default(autoincrement())
  nombre         String
  descripcion    String?
  fechaInicio    DateTime
  fechaFin       DateTime
  porcentajeDesc Decimal  @db.Decimal(5, 2)
  activa         Boolean  @default(true)

  productos PromocionProducto[]
}

model PromocionProducto {
  id Int @id @default(autoincrement())

  promocionId Int
  promocion   Promocion @relation(fields: [promocionId], references: [id])

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  @@unique([promocionId, productoId])
}
