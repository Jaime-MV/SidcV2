generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// MÓDULO: INVENTARIO, PRODUCTOS Y BODEGAS
// -------------------------------------------------------------

model Bodega {
  id             Int     @id @default(autoincrement())
  codigo         String? @unique // Ej. "BOD-01"
  nombre         String
  ubicacion      String?
  capacidadTotal Int     @default(0)
  capacidadUsada Int     @default(0)
  encargado      String?

  productos Producto[]
}

model Categoria {
  id          Int     @id @default(autoincrement())
  nombre      String  @unique
  descripcion String?
  colorHex    String? @default("#6b7280") // Color para gráficas (Ej. "#3b82f6")

  productos Producto[]
}

model Producto {
  id             Int            @id @default(autoincrement())
  codigo         String?        @unique // Ej. "P001"
  nombre         String
  descripcion    String?
  codigoBarras   String?        @unique
  precioCompra   Decimal        @default(0) @db.Decimal(10, 2)
  precioVenta    Decimal        @default(0) @db.Decimal(10, 2)
  minStock       Int            @default(0)
  estadoProducto EstadoProducto @default(NORMAL) // Estado calculado/manual

  categoriaId Int
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  bodegaId Int?
  bodega   Bodega? @relation(fields: [bodegaId], references: [id])

  lotes               Lote[]
  detallesVenta       DetalleVenta[]
  promociones         PromocionProducto[]
  devoluciones        Devolucion[]
  estadisticaProducto EstadisticaProducto?
}

// Estado calculado del producto según stock y vencimiento
enum EstadoProducto {
  NORMAL
  STOCK_BAJO
  POR_VENCER
  CRITICO
  VENCIDO
}

model Lote {
  id                 Int      @id @default(autoincrement())
  numeroLote         String   @unique
  fechaFabricacion   DateTime
  fechaVencimiento   DateTime
  cantidadInicial    Int
  cantidadDisponible Int

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  movimientos MovimientoInventario[]
}

model MovimientoInventario {
  id              Int            @id @default(autoincrement())
  tipoMovimiento  TipoMovimiento
  cantidad        Int
  fechaMovimiento DateTime       @default(now())
  referencia      String? // Ej. "Venta V-001", "Devolución D-001"

  loteId Int
  lote   Lote @relation(fields: [loteId], references: [id])
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
}

// -------------------------------------------------------------
// MÓDULO: RUTAS Y VENDEDORES
// -------------------------------------------------------------

model Vendedor {
  id       Int     @id @default(autoincrement())
  nombre   String
  telefono String?
  activo   Boolean @default(true)

  rutas  Ruta[]
  ventas Venta[]
}

model Ruta {
  id           Int        @id @default(autoincrement())
  codigo       String?    @unique // Ej. "R-01"
  nombre       String
  descripcion  String?
  vehiculo     String?
  kmEstimados  Int?
  horaInicio   String?
  horaFin      String?
  departamento String?
  estado       EstadoRuta @default(PENDIENTE)

  // Estadísticas de entregas del día (operativas)
  clientesTotal       Int @default(0) // Total clientes asignados a la ruta
  entregasHoy         Int @default(0) // Entregas programadas para hoy
  entregasCompletadas Int @default(0) // Entregas realizadas hoy

  vendedorId Int
  vendedor   Vendedor @relation(fields: [vendedorId], references: [id])

  clientes Cliente[]
}

enum EstadoRuta {
  EN_RUTA
  COMPLETADA
  PENDIENTE
  CANCELADA
}

// -------------------------------------------------------------
// MÓDULO: CLIENTES Y CRÉDITO
// -------------------------------------------------------------

model Cliente {
  id             Int           @id @default(autoincrement())
  codigo         String?       @unique // Ej. "C001"
  nombre         String
  identificacion String        @unique // NIT o Documento Similar
  direccion      String
  telefono       String?
  email          String?
  tipo           TipoCliente   @default(TIENDA)
  estado         EstadoCliente @default(ACTIVO)
  ultimaCompra   DateTime? // Fecha de la última compra

  // Condición de pago/Crédito
  limiteCredito Decimal @default(0) @db.Decimal(12, 2)
  saldoActual   Decimal @default(0) @db.Decimal(12, 2)
  diasCredito   Int     @default(0) // 0 denota Contado

  rutaId Int?
  ruta   Ruta? @relation(fields: [rutaId], references: [id])

  ventas Venta[]
  cobros Cobro[]
}

enum TipoCliente {
  SUPERMERCADO
  FARMACIA
  TIENDA
  MAYORISTA
}

enum EstadoCliente {
  ACTIVO
  BLOQUEADO
  SUSPENDIDO
}

// -------------------------------------------------------------
// MÓDULO: VENTAS Y FACTURACIÓN
// -------------------------------------------------------------

model Venta {
  id             Int         @id @default(autoincrement())
  fecha          DateTime    @default(now())
  subtotal       Decimal     @db.Decimal(12, 2)
  descuentoTotal Decimal     @default(0) @db.Decimal(12, 2)
  total          Decimal     @db.Decimal(12, 2)
  estado         EstadoVenta @default(COMPLETADA)

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  vendedorId Int
  vendedor   Vendedor @relation(fields: [vendedorId], references: [id])

  detalles     DetalleVenta[]
  factura      Factura? // Relación 1 a 1
  devoluciones Devolucion[]
}

enum EstadoVenta {
  PENDIENTE
  COMPLETADA
  ANULADA
}

model DetalleVenta {
  id             Int     @id @default(autoincrement())
  cantidad       Int
  precioUnitario Decimal @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  ventaId Int
  venta   Venta @relation(fields: [ventaId], references: [id])

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])
}

model Factura {
  id               Int           @id @default(autoincrement())
  numeroFactura    String        @unique
  fechaEmision     DateTime      @default(now())
  fechaVencimiento DateTime? // Fecha límite de pago
  total            Decimal       @db.Decimal(12, 2)
  estado           EstadoFactura @default(CREADA)

  ventaId Int   @unique
  venta   Venta @relation(fields: [ventaId], references: [id])

  cobros Cobro[]
}

enum EstadoFactura {
  CREADA
  PAGADA
  PAGADA_PARCIALMENTE
  ANULADA
  VENCIDA
}

// -------------------------------------------------------------
// MÓDULO: COBROS (PAGOS)
// -------------------------------------------------------------

model Cobro {
  id             Int         @id @default(autoincrement())
  codigo         String?     @unique // Ej. "COB-0095"
  fecha          DateTime    @default(now())
  fechaPago      DateTime? // Fecha efectiva de pago (si ya se cobró)
  monto          Decimal     @db.Decimal(12, 2)
  metodoPago     MetodoPago?
  referenciaPago String?
  estado         EstadoCobro @default(PENDIENTE)
  diasVencido    Int         @default(0) // Días transcurridos desde vencimiento

  facturaId Int
  factura   Factura @relation(fields: [facturaId], references: [id])

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id])
}

enum MetodoPago {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  CHEQUE
}

enum EstadoCobro {
  COBRADO
  PENDIENTE
  VENCIDO
}

// -------------------------------------------------------------
// MÓDULO: DEVOLUCIONES
// -------------------------------------------------------------

model Devolucion {
  id       Int              @id @default(autoincrement())
  codigo   String?          @unique // Ej. "DEV-0021"
  fecha    DateTime         @default(now())
  motivo   String
  estado   EstadoDevolucion @default(PROCESADA)
  cantidad Int              @default(1)
  monto    Decimal          @default(0) @db.Decimal(10, 2)

  ventaId Int
  venta   Venta @relation(fields: [ventaId], references: [id])

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])
}

enum EstadoDevolucion {
  PENDIENTE
  PROCESADA
  RECHAZADA
  APROBADA
}

// -------------------------------------------------------------
// MÓDULO: PROMOCIONES
// -------------------------------------------------------------

model Promocion {
  id             Int             @id @default(autoincrement())
  codigo         String?         @unique // Ej. "PROMO-01"
  nombre         String
  tipo           TipoPromocion   @default(DESCUENTO)
  descripcion    String?
  fechaInicio    DateTime
  fechaFin       DateTime
  porcentajeDesc Decimal         @db.Decimal(5, 2)
  canal          String? // Ej. "Supermercados", "Todos"
  usos           Int             @default(0)
  presupuesto    Decimal         @default(0) @db.Decimal(12, 2)
  gastado        Decimal         @default(0) @db.Decimal(12, 2)
  estado         EstadoPromocion @default(ACTIVA)

  activa Boolean @default(true) // Legacy status flag

  productos PromocionProducto[]
}

enum TipoPromocion {
  VOLUMEN
  DESCUENTO
  COMBO
  ESPECIAL
}

enum EstadoPromocion {
  ACTIVA
  PROXIMA
  EXPIRADA
}

model PromocionProducto {
  id Int @id @default(autoincrement())

  promocionId Int
  promocion   Promocion @relation(fields: [promocionId], references: [id])

  productoId Int
  producto   Producto @relation(fields: [productoId], references: [id])

  @@unique([promocionId, productoId])
}

// -------------------------------------------------------------
// MÓDULO: ANALYTICS / RESÚMENES (para Dashboard)
// -------------------------------------------------------------

// Resumen mensual de ventas/cobros/devoluciones (precalculado)
model ResumenMensual {
  id           Int     @id @default(autoincrement())
  anio         Int // Ej. 2026
  mes          Int // 1-12
  mesLabel     String // Ej. "Mar '26"
  ventas       Decimal @default(0) @db.Decimal(14, 2)
  cobros       Decimal @default(0) @db.Decimal(14, 2)
  devoluciones Decimal @default(0) @db.Decimal(14, 2)

  @@unique([anio, mes])
}

// Caché de estadísticas del producto (actualizado por job o trigger)
model EstadisticaProducto {
  id           Int     @id @default(autoincrement())
  totalVendido Int     @default(0) // Unidades vendidas históricas
  ingresos     Decimal @default(0) @db.Decimal(14, 2)

  productoId Int      @unique
  producto   Producto @relation(fields: [productoId], references: [id])
}

// Relación inversa en Producto
// (se agrega el campo en el modelo Producto arriba)
